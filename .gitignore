# Personal Kiro hooks with hardcoded user paths (e.g., Obsidian publish/sync).
# These are local automation, not team-shareable. Keep them on disk but out of git.
.kiro/hooks/publish-specs-obsidian.kiro.hook
.kiro/hooks/sync-specs-obsidian.kiro.hook

# Internal Amazon reference material — not for a public-facing repo. Keep local.
Internal training document_Amazon GitHub Requirements.txt

# Personal session recaps and publish one-offs with internal context and
# hardcoded local paths. Local working notes, not for a public repo.
docs/recaps/
scripts/publish_*.py
