# Required: Anthropic API key for the LLM
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Required: Tavily API key for external web research
TAVILY_API_KEY=your_tavily_api_key_here

# Optional: Dovetail API token for UX research data.
# The Dovetail integration is optional. If you don't use Dovetail, leave
# this blank and the research agent will rely on Tavily web search only.
DOVETAIL_API_TOKEN=

# Model configuration (set by crewai)
MODEL=claude-3-5-sonnet-20240620

# The system uses Claude Sonnet via the Anthropic API.
# To use a different model, update the llm parameter in crew.py.

# Optional: Output directory for research briefs (default: ./output)
OUTPUT_DIR=./output

# Agent 2 - PRFAQ Agent
# Path to the writing style guide. Defaults to samples/style-guide-sample.md
# in the project root if unset. Override to point at your own style guide.
STYLE_GUIDE_PATH=

# Optional: SharePoint MCP (requires Azure AD credentials from enterprise IT)
# SHAREPOINT_TENANT_ID=
# SHAREPOINT_CLIENT_ID=
# SHAREPOINT_CLIENT_SECRET=
# SHAREPOINT_URL=

# Optional: Outlook MCP (requires Azure AD credentials from enterprise IT)
# MS_CLIENT_ID=
# MS_CLIENT_SECRET=
# MS_TENANT_ID=

# Agent 3 - BRD + Build Spec Agent
# Uses Tavily (same key as Agent 1) for cost flagging and API doc lookups.
# Uses Claude (same key as Agents 1-2) for BRD and build spec generation.
# No additional API keys required.
#
# Default coding tool for build spec (CLI --target-tool overrides this).
# Options: kiro, claude_code, cursor, lovable
DEFAULT_TARGET_TOOL=kiro

# Obsidian vault root for ObsidianSearchTool / ObsidianReadTool.
# Optional. Set to your local Obsidian vault path (e.g. ~/Obsidian) if you
# want the agents to search and read your personal notes. Leave blank if
# you don't use Obsidian.
OBSIDIAN_VAULT_PATH=

# Output retention: files in OUTPUT_DIR older than this many days are
# moved to ./output/archive/ at the start of every run. Default: 30.
OUTPUT_RETENTION_DAYS=30
