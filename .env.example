# Required: Anthropic API key for the LLM
# Only required when LLM_PROVIDER is unset or set to "anthropic".
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# LLM Provider Selection
# Set to "bedrock" to route all LLM calls through AWS Bedrock using the
# AWS_BEARER_TOKEN_BEDROCK env var below. Leave unset (or set to "anthropic")
# to use the direct Anthropic API with ANTHROPIC_API_KEY.
# LLM_PROVIDER=anthropic

# AWS Bedrock configuration (only needed when LLM_PROVIDER=bedrock)
# - AWS_BEARER_TOKEN_BEDROCK: a Bedrock API key (bearer token) generated
#   from the AWS Bedrock console. The value starts with "bedrock-api-key-".
# - AWS_BEDROCK_REGION: the region where Bedrock is enabled for your account
#   (e.g., us-east-2 for Ohio). Cross-region inference profiles like
#   "us.anthropic.claude-sonnet-4-6" work in any US region.
# - BEDROCK_MODEL_ID: the inference profile ID for the Claude model. If you
#   provide a plain model ID like "anthropic.claude-sonnet-4-6", the code
#   will auto-prepend "us." so that on-demand invocation works.
# AWS_BEARER_TOKEN_BEDROCK=
# AWS_BEDROCK_REGION=us-east-2
# BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-6

# Required: Tavily API key for external web research
TAVILY_API_KEY=your_tavily_api_key_here

# Optional: Dovetail API token for UX research data.
# The Dovetail integration is optional. If you don't use Dovetail, leave
# this blank and the research agent will rely on Tavily web search only.
DOVETAIL_API_TOKEN=

# Optional: Override the Dovetail MCP endpoint URL (default: https://dovetail.com/api/mcp)
# DOVETAIL_MCP_BASE_URL=

# LLM Model
# The system defaults to Claude Opus 4.8. On the direct Anthropic path,
# override the model with ANTHROPIC_MODEL_ID below; on the Bedrock path,
# use BEDROCK_MODEL_ID. The MODEL env var is NOT read by this project (it
# is a CrewAI convention we override in code).
#
# ANTHROPIC_MODEL_ID: the model id for the direct Anthropic path.
#   Default: claude-opus-4-8. Set to claude-fable-5 for Claude Fable 5
#   (most capable; higher cost). Set to claude-sonnet-5 for lower cost.
#   Note: Fable requires an org data-retention setting of 30 days or more
#   and is not enabled on every Bedrock account, so it is not the default.
# ANTHROPIC_MODEL_ID=claude-opus-4-8

# Optional: Output directory for research briefs (default: ./output)
OUTPUT_DIR=./output

# Optional: Output directory for research briefs (default: ./output)
OUTPUT_DIR=./output

# Agent 2 - PRFAQ Agent
# Path to the writing style guide. Defaults to examples/templates/style-guide-sample.md
# in the project root if unset. Override to point at your own style guide.
STYLE_GUIDE_PATH=

# Agent 3 - Design Brief + Wireframe Agent
# Optional — visual/brand style guide for wireframe generation.
# If set, Agent 3 (Design Brief) applies brand colors, typography,
# and component preferences to wireframes and references them in the brief.
# A sample template lives at examples/templates/visual-style-guide.md.
# VISUAL_STYLE_GUIDE_PATH=config/visual-style-guide.md

# AWS Pricing API (used by Agent 4 for cost flagging)
# The AWS Price List API is public. However, boto3 may require credentials.
# If you see authentication errors, add any valid AWS credentials here
# (no special permissions needed — the Pricing API is publicly accessible).
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
AWS_PRICING_REGION=us-east-1

# Agent 4 - BRD + Build Spec Agent
# (Agent 3 is reserved for the planned Design Brief + Wireframe agent.)
# Uses Tavily (same key as Agent 1) for cost flagging and API doc lookups.
# Uses Claude (same key as Agents 1-2) for BRD and build spec generation.
#
# Default coding tool for build spec (CLI --target-tool overrides this).
# Options: kiro, claude_code, cursor, lovable
DEFAULT_TARGET_TOOL=kiro

# Jira/Linear import column mappings — edit config/jira_import_schema.yaml
# and config/linear_import_schema.yaml to match your instance's field names
# before importing the generated brd_*_jira_import.csv / brd_*_linear_import.md.

# Obsidian vault integration (optional)
# Set OBSIDIAN_VAULT_PATH to enable writing artifacts to your Obsidian vault.
# Artifacts include frontmatter, wikilinks, and version history.
# Also enables agents to search and read your personal notes via
# ObsidianSearchTool / ObsidianReadTool.
# If not set, vault integration is silently disabled.
# OBSIDIAN_VAULT_PATH=/path/to/your/obsidian/vault
OBSIDIAN_VAULT_PATH=
# Top-level folder name inside the vault for PM Agent artifacts (default: PM Agent)
# OBSIDIAN_FOLDER_PREFIX=PM Agent

# Output retention: files in OUTPUT_DIR older than this many days are
# moved to ./output/archive/ at the start of every run. Default: 30.
OUTPUT_RETENTION_DAYS=30

# ── Internal Amazon MCP integrations (optional) ──────────────────────
# All five variables below are optional. When unset, the pipeline runs
# unchanged and no internal MCP tools are loaded.
# See docs/internal-mcp-setup.md for the full setup and cookie refresh
# workflow.

# Builder MCP: wiki, code search, Taskei, Quip, pipelines.
# BUILDER_MCP_TOKEN=
# BUILDER_MCP_ENDPOINT=  # set to your internal builder-mcp JSON-RPC endpoint

# Outlook MCP: calendar, email metadata, room booking.
# OUTLOOK_MCP_TOKEN=
# OUTLOOK_MCP_ENDPOINT=  # set to your internal outlook-mcp JSON-RPC endpoint

# Midway cookie sharing: one cookie file usable from Windows and WSL.
# When set and the file exists, the two MCP tools authenticate via the
# cookie and do not require the token env vars above. When the cookie
# file is missing or expired, the tools fall back to the token path.
# Refresh with: mwinit -f
# MIDWAY_COOKIE_PATH=

# Read integrations (optional): each read tool attaches to an agent only
# when its binary is on PATH. Auth is handled by the binary. Override the
# binary/tool names only if your registry registers them differently.
# PIPPIN_MCP_BINARY=python-pippin-mcp             # pippin_read on the research agent
# QUICKSIGHT_MCP_BINARY=quicksight-mcp            # quicksight_dashboard on the BRD agent
# SOFTWARE_CATALOG_MCP_BINARY=software-catalog-mcp # software_catalog on research + BRD
# VIRTUAL_PM_MCP_BINARY=virtual-pm-mcp            # virtual_pm_critique on the PRFAQ agent
# Assumed-contract tool-name overrides (correct after a live smoke test):
# SOFTWARE_CATALOG_LOOKUP_TOOL=lookup_entity
# SOFTWARE_CATALOG_CYPHER_TOOL=run_cypher
# VIRTUAL_PM_MCP_TOOL=sentinel_review
# QUICKSIGHT_MCP_TOOL=get_dashboard_data

# ── Gated write-back integrations (internal Amazon only) ─────────────
# The publish-doc / seed-taskei / ingest-feedback commands are the only
# commands that write outside ./output/. They use the builder-mcp and
# slack-mcp Gateway client binaries + a live Midway session; auth is
# handled by the binaries, so no tokens are needed here. Every external
# write requires an explicit interactive confirmation (default No).

# seed-taskei has no default room (there is none sensible for an OSS
# tool). Set the Taskei room UUID to create tasks in, or pass
# --taskei-room on the command line. Required for seed-taskei.
# TASKEI_ROOM_ID=

# The remote MCP tool names are the live builder-mcp/slack-mcp names and
# rarely need changing. Override only if your registry registers them
# differently (mirrors WB_AI_MCP_TOOL).
# WRITE_BACK_MCP_BINARY=builder-mcp
# WRITE_BACK_QUIP_TOOL=QuipEditor
# WRITE_BACK_TASKEI_TOOL=TaskeiCreateTask
# SLACK_MCP_BINARY=slack-mcp
# SLACK_MCP_MESSAGES_TOOL=get_messages

# publish-doc --target sharepoint rides a SEPARATE binary (sharepoint-mcp)
# with FedAuth cookie auth, not the builder-mcp Midway path. The create tool
# name is assumed (the binary would not install to confirm it); override it
# after a live smoke test if it differs.
# WRITE_BACK_SHAREPOINT_BINARY=sharepoint-mcp
# WRITE_BACK_SHAREPOINT_TOOL=create_document

# publish-doc --target pippin rides python-pippin-mcp. create_artifact needs a
# project_id with no OSS default; set it here or pass --pippin-project.
# PIPPIN_MCP_BINARY=python-pippin-mcp
# WRITE_BACK_PIPPIN_TOOL=create_artifact
# PIPPIN_PROJECT_ID=
