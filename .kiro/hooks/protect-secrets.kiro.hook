{
  "enabled": true,
  "name": "Protect Secrets and Output",
  "description": "Blocks writes to .env files and the output directory to prevent accidental exposure of API keys or proprietary pipeline output",
  "version": "1",
  "when": {
    "type": "preToolUse",
    "toolTypes": [
      "write"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "SECURITY CHECK: If this write targets a .env file (not .env.example) or any file inside the output/ directory, STOP. These files contain API keys or proprietary pipeline output and must not be written by the agent. Only .env.example may be edited. If the write target is safe, proceed normally."
  }
}