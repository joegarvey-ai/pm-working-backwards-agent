# Private fork .gitignore
# Append this to your .gitignore after forking for personal use.
# Keeps company-specific content out of git.

# Stakeholder avatars (names, roles, political dynamics)
config/stakeholder_avatars/

# Internal documents uploaded for agent context
internal_docs/

# Custom style guide with company voice
samples/my-style-guide.md

# Output from real pipeline runs (may contain proprietary content)
output/*.md
output/*.txt
output/*.yaml
output/archive/

# Environment with real API keys
.env

# Personal Obsidian vault path config
.obsidian-config
